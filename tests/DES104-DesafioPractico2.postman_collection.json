{
  "info": {
    "name": "DES104 - Desafio Practico 2 (API Gateway)",
    "description": "Colección completa del sistema distribuido: autenticación en el Gateway, CRUD de clientes, pedidos, pruebas de caché y validaciones. El Gateway devuelve la cookie de sesión; Postman y Bruno la reenvían automáticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:5000"
    }
  ],
  "item": [
    {
      "name": "00 - Autenticacion",
      "item": [
        {
          "name": "Login (obtiene la cookie de sesion)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/auth/login",
              "host": [
                "{{gateway}}/auth/login"
              ]
            },
            "description": "Ejecutar SIEMPRE primero. Devuelve la cookie que el Gateway valida en cada ruta.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@udb.edu.sv\",\n  \"password\": \"Desafio2026*\",\n  \"recordarme\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Sesion actual",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway}}/auth/me",
              "host": [
                "{{gateway}}/auth/me"
              ]
            },
            "description": "Confirma que la sesión está activa."
          },
          "response": []
        },
        {
          "name": "Registrar usuario nuevo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/auth/register",
              "host": [
                "{{gateway}}/auth/register"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"estudiante@udb.edu.sv\",\n  \"password\": \"Estudiante2026*\",\n  \"nombreCompleto\": \"Estudiante DES104\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gateway}}/auth/logout",
              "host": [
                "{{gateway}}/auth/logout"
              ]
            },
            "description": "Cierra la sesión. Útil para demostrar el error 401 estandarizado."
          },
          "response": []
        }
      ]
    },
